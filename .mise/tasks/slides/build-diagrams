#!/usr/bin/env bash
set -euo pipefail

INPUT_DIR="slides/diagrams"
OUTPUT_DIR="slides/public/diagrams/ai_in_production"
MMDC="slides/node_modules/.bin/mmdc"
CONFIG="slides/mermaid.config.json"

mkdir -p "$OUTPUT_DIR"

pids=()
failed=0

while IFS= read -r -d '' f; do
  [[ ! -s "$f" ]] && echo "Skipping empty file: $f" && continue

  rel="${f#"$INPUT_DIR/"}"
  out="$OUTPUT_DIR/${rel%.mmd}.svg"
  mkdir -p "$(dirname "$out")"

  "$MMDC" -i "$f" -o "$out" -c "$CONFIG" -b transparent &
  pids+=($!)
done < <(find "$INPUT_DIR" -name "*.mmd" -print0)

for pid in "${pids[@]}"; do
  wait "$pid" || failed=1
done

[[ $failed -ne 0 ]] && echo "ERROR: one or more diagram builds failed" && exit 1
echo "Diagrams built successfully"
